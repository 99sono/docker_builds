# .env.example for development_image/05_docker_compose_template
# Copy this file to ".env" in the same directory and fill in your real values.
# IMPORTANT: Commit this .env.example, but NEVER commit your actual ".env" file.

# OpenAI Codex (optional — alternative to `codex login` inside the container)
OPENAI_API_KEY=your_openai_api_key_here

# Note: Cline, OpenCode, and Antigravity manage their own authentication
# (via their respective login flows) and do not require environment variables
# for basic operation.
